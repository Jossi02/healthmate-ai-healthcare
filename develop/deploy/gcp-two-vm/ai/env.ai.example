# AI providers
GEMINI_API_KEY=your-gemini-api-key
ROUTER_API_KEY=
GEMINI_MODEL_NAME=gemini-3.5-flash
ROUTER_MODEL_NAME=gemini-3.5-flash
ENABLE_RAG_MEMORY=false
PINECONE_INDEX_NAME=your-index-name
PINECONE_API_KEY=

# Backend public HTTPS origin served by Caddy
WAS_BASE_URL=https://api.example.com
WAS_TIMEOUT=10.0
INTERNAL_API_KEY=your-internal-api-key

# Runtime
APP_ENV=production
LOG_LEVEL=INFO
CHECKPOINT_DB_PATH=/app/data/checkpoints.sqlite
# Required Compose interpolation value: the AI VM's private interface address.
# Keep GCP firewall ingress on tcp:8000 limited to the Backend VM/private network too.
AI_BIND_ADDRESS=replace-with-ai-vm-private-interface-address

# Optional tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your-langsmith-api-key
LANGCHAIN_PROJECT=capstone-v2

BACKEND_DOMAIN=api.example.com

PORT=8080
NODE_ENV=production

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Frontend origin
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app

# Caddy is the single trusted reverse proxy in this Compose topology.
TRUST_PROXY_HOPS=1

# AI private IP inside the same GCP VPC
FASTAPI_URL=http://10.0.0.5:8000
AI_REQUEST_TIMEOUT=90000
INTERNAL_API_KEY=your_internal_api_key_here
# Demo default: false allows memory fallback if the idempotency migration is not applied yet.
# Set true after applying 20260531090000_add_ai_was_idempotency_keys.sql.
REQUIRE_IDEMPOTENCY_TABLE=false

# Auth
JWT_SECRET=your_jwt_secret_here

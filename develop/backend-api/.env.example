PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# Supabase (DB)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# FastAPI 서버 주소
FASTAPI_URL=http://localhost:8000

# CORS 허용 origin (정확한 값을 쉼표로 구분; production에서는 필수, * 금지)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 신뢰할 reverse proxy hop 수 (직접 실행 0, 단일 Caddy/Nginx 뒤에서는 1)
TRUST_PROXY_HOPS=0

# AI 요청 타임아웃 (ms)
AI_REQUEST_TIMEOUT=90000

# Internal service auth (AI 서버와 같은 값을 사용)
INTERNAL_API_KEY=your_internal_api_key_here

# JWT (fallback을 사용하지 말고 충분히 긴 별도 값을 설정)
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# 인증 rate limit (signup/login에만 적용)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# true이면 데이터베이스 idempotency 테이블이 준비되어 있어야 함
REQUIRE_IDEMPOTENCY_TABLE=false

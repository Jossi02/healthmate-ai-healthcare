GEMINI_API_KEY=your-gemini-api-key
ROUTER_API_KEY=
GEMINI_MODEL_NAME=gemini-3.5-flash
ROUTER_MODEL_NAME=gemini-3.5-flash
ENABLE_RAG_MEMORY=false
PINECONE_INDEX_NAME=your-index-name
PINECONE_API_KEY=
WAS_BASE_URL=http://localhost:8080
WAS_TIMEOUT=10.0
INTERNAL_API_KEY=your-internal-api-key
SUMMARY_TURN_INTERVAL=10
MAX_MESSAGES=10
CHECKPOINT_DB_PATH=data/checkpoints.sqlite
CHECKPOINT_TTL_HOURS=72
APP_ENV=development
ENABLE_DEBUG_ROUTES=false
LOG_LEVEL=INFO
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your-langsmith-api-key
LANGCHAIN_PROJECT=capstone-v2

# LangSmith quality export (disabled by default; enable only after adding a real key)
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=capstone-v2
LANGSMITH_QUALITY_ENABLED=false
LANGSMITH_SEND_FULL_TEXT=false
LANGSMITH_MAX_CHILD_RUNS=80
LANGSMITH_CHILD_EVENT_SAMPLE_RATE=1.0
